---
/** Branchepagina (/voor/<slug>), in dezelfde opbouw als in de Review Plus-shop. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/shop/ProductCard.astro';
import ProductVisual from '@/components/shop/ProductVisual.astro';
import Teller from '@/components/shop/Teller.astro';
import HowItWorks from '@/components/shop/HowItWorks.astro';
import SamenPromo from '@/components/shop/SamenPromo.astro';
import Faq from '@/components/shop/Faq.astro';
import CtaBand from '@/components/shop/CtaBand.astro';
import { producten, sectoren, type Product, type Sector } from '@/lib/catalog';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const [lijst, alle] = await Promise.all([sectoren(), producten()]);
  return lijst.map((s) => ({ params: { sector: s.data.slug }, props: { sector: s, alle } }));
}

interface Props {
  sector: Sector;
  alle: Product[];
}
const { sector, alle } = Astro.props;
const s = sector.data;
const product = (slug: string) => alle.find((p) => p.data.slug === slug);
---
<BaseLayout
  title={s.metaTitle}
  description={s.metaDescription}
  path={`/voor/${s.slug}`}
  page="sector"
  sector={s.slug}
  schemas={[breadcrumbSchema([{ name: 'Shop', path: '/' }, { name: s.naam, path: `/voor/${s.slug}` }]), faqSchema(s.faq)]}
>
  <section class="grid-bg">
    <div class="container-rp grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.1fr_1fr]">
      <div class="grid gap-6">
        <p class="chip w-fit">Voor {s.naam.toLowerCase()} · NL &amp; BE</p>
        <h1 class="text-4xl md:text-[3.2rem]">{s.heroTitel}</h1>
        <p class="max-w-xl text-lg leading-relaxed text-ink-soft">{s.samenvatting}</p>
        <div class="flex flex-wrap gap-3">
          <a href="#producten" class="btn btn-primary btn-lg">Bekijk de producten</a>
          <a href="#voorbeelden" class="btn btn-secondary btn-lg">Zo gebruik je ze</a>
        </div>
        <p class="text-sm text-ink-soft">{s.heroTekst}</p>
      </div>
      <div class="card grid aspect-[4/3] place-items-center overflow-hidden !rounded-[var(--radius-panel)] shadow-[var(--shadow-glow)]">
        <div class="rp-stage grid h-full w-full place-items-center p-[8%]">
          <Teller platform="Instagram" waarde={1248} class="w-full" />
        </div>
      </div>
    </div>
  </section>

  <section id="voorbeelden" class="container-rp scroll-mt-32 py-16" aria-labelledby="vb-title">
    <p class="eyebrow">Voorbeelden</p>
    <h2 id="vb-title" class="mt-2 text-3xl md:text-4xl">Zo zet je de teller en de standaard in</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {s.voorbeelden.map((v) => {
        const p = product(v.product);
        return (
          <li class="card overflow-hidden">
            {p && (
              <div class="rp-stage grid aspect-[4/3] place-items-center p-[10%]">
                <ProductVisual product={p} class={p.data.visual === 'standaard' ? 'w-[42%]' : 'w-full'} />
              </div>
            )}
            <div class="grid gap-2 p-5">
              <h3 class="text-lg !text-ink">{v.titel}</h3>
              <p class="text-ink-soft">{v.tekst}</p>
              {p && <a href={url(`/${p.data.slug}`)} class="w-fit text-sm font-medium text-brand-600 hover:underline">{p.data.naam} →</a>}
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <HowItWorks />

  <section id="producten" class="container-rp scroll-mt-32 py-12" aria-labelledby="prod-title">
    <h2 id="prod-title" class="text-3xl md:text-4xl">Het aanbod</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {alle.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <SamenPromo />
  <Faq items={s.faq} />
  <CtaBand />
</BaseLayout>
