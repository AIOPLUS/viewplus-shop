---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaginaKop from '@/components/shop/PaginaKop.astro';
import { url } from '@/lib/url';
---
<BaseLayout title="Pagina niet gevonden | View Plus Shop" description="Deze pagina bestaat niet (meer)." path="/404" noindex page="404">
  <PaginaKop titel="Pagina niet gevonden" tekst="Deze pagina bestaat niet (meer). Misschien vind je hieronder wat je zoekt.">
    <div class="mt-4 flex flex-wrap justify-center gap-3">
      <a href={url('/')} class="btn btn-primary">Naar de shop</a>
      <a href={url('/live-volgersteller')} class="btn btn-soft">Live volgersteller</a>
      <a href={url('/live-teller-op-maat')} class="btn btn-soft">Live teller naar keuze</a>
      <a href={url('/contact')} class="btn btn-soft">Contact</a>
    </div>
  </PaginaKop>
</BaseLayout>
