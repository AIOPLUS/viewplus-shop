---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/shop/ProductCard.astro';
import Teller from '@/components/shop/Teller.astro';
import HowItWorks from '@/components/shop/HowItWorks.astro';
import SamenPromo from '@/components/shop/SamenPromo.astro';
import Faq from '@/components/shop/Faq.astro';
import CtaBand from '@/components/shop/CtaBand.astro';
import { brand } from '@/config/brand';
import { faq } from '@/config/content';
import { producten, sectoren } from '@/lib/catalog';
import { breadcrumbSchema, faqSchema, productenSchema } from '@/lib/schema';
import { url } from '@/lib/url';

const lijst = await producten();
const branches = await sectoren();
---
<BaseLayout
  title="Live volgerstellers en NFC-volgstandaards voor je zaak | View Plus Shop"
  description="Maak je volgers zichtbaar in je zaak: live tellers met klapcijfers voor Instagram, Facebook en TikTok, en NFC-volgstandaards waarmee gasten je met één tik volgen."
  path="/"
  page="home"
  schemas={[breadcrumbSchema([{ name: 'Shop', path: '/' }]), productenSchema(lijst), faqSchema(faq)]}
>
  <section class="grid-bg relative overflow-hidden">
    <div class="container-rp grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.1fr_1fr]">
      <div class="grid gap-6">
        <p class="chip w-fit">Live tellers · NFC-volgstandaards · NL &amp; BE</p>
        <h1 class="text-4xl md:text-[3.4rem]">Maak je volgers zichtbaar in je zaak</h1>
        <p class="max-w-xl text-lg leading-relaxed text-ink-soft">
          Met een live volgersteller zien je gasten hoeveel volgers je hebt op Instagram, Facebook of TikTok. De klapcijfers
          draaien mee bij elke nieuwe volger. Met de NFC-volgstandaard volgen ze je met één tik.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#producten" class="btn btn-primary btn-lg">Bekijk de producten</a>
          <a href={url('/contact')} class="btn btn-secondary btn-lg" data-track="advies_klik" data-track-plek="hero">Vraag advies</a>
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft">
          <li class="flex items-center gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> Instagram, Facebook en TikTok</li>
          <li class="flex items-center gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> Klapcijfers die meedraaien</li>
          <li class="flex items-center gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> Volgen zonder app</li>
        </ul>
      </div>
      <div class="card grid gap-5 overflow-hidden !rounded-[var(--radius-panel)] p-0 shadow-[var(--shadow-glow)]">
        <div class="rp-stage grid place-items-center px-[7%] pb-[9%] pt-[11%]">
          <Teller id="demo-teller" platform="Instagram" waarde={1248} class="w-full" label="Voorbeeld van een live volgersteller" />
        </div>
        <div class="flex flex-wrap items-center justify-between gap-4 px-6 pb-6">
          <div class="grid gap-0.5">
            <p class="font-medium text-ink">Probeer het zelf</p>
            <p class="text-sm text-ink-soft">Klik op Volgen en zie de cijfers omklappen.</p>
          </div>
          <button type="button" class="btn btn-primary" data-demo-volg aria-controls="demo-teller">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Volgen
          </button>
        </div>
        <p class="sr-only" aria-live="polite" data-demo-status></p>
      </div>
    </div>
  </section>

  <HowItWorks />

  <section id="producten" class="container-rp scroll-mt-32 py-12" aria-labelledby="producten-title">
    <p class="eyebrow">Het aanbod</p>
    <h2 id="producten-title" class="mt-2 text-3xl md:text-4xl">Kies wat bij jouw zaak past</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {lijst.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <SamenPromo />

  <section class="container-rp py-12" aria-labelledby="online-title">
    <div class="card grid gap-6 p-8 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="eyebrow">View Plus Online</p>
        <h2 id="online-title" class="mt-2 text-2xl">Nieuwe volgers verdienen sterke content</h2>
        <p class="mt-2 max-w-2xl text-ink-soft">Met View Plus Online nemen we je social media volledig uit handen: professionele fotografie, een contentkalender en 2 tot 3 posts per week.</p>
      </div>
      <a href={`${brand.hoofdsiteUrl}/plans`} class="btn btn-secondary">Bekijk View Plus Online</a>
    </div>
  </section>

  <section class="container-rp py-12" aria-labelledby="sectoren-title">
    <h2 id="sectoren-title" class="text-2xl">Voorbeelden per branche</h2>
    <ul class="mt-5 flex flex-wrap gap-2">
      {branches.map((s) => <li><a class="btn btn-secondary" href={url(`/voor/${s.data.slug}`)}>{s.data.naam}</a></li>)}
    </ul>
  </section>

  <Faq items={faq} />
  <CtaBand />
</BaseLayout>

<script>
  import { setTeller } from '@/lib/client/teller';
  import { track } from '@/lib/client/analytics';

  const kast = document.querySelector<HTMLElement>('#demo-teller');
  const knop = document.querySelector<HTMLButtonElement>('[data-demo-volg]');
  const status = document.querySelector<HTMLElement>('[data-demo-status]');
  let bezig = false;
  knop?.addEventListener('click', async () => {
    if (!kast || bezig) return;
    bezig = true;
    const nieuw = Number(kast.dataset.waarde ?? 0) + 1;
    await setTeller(kast, nieuw);
    if (status) status.textContent = `Teller staat nu op ${nieuw.toLocaleString('nl-NL')}`;
    track('demo_teller', {});
    bezig = false;
  });
</script>
