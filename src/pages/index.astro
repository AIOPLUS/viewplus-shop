---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/shop/ProductCard.astro';
import TellerKiezer from '@/components/shop/TellerKiezer.astro';
import HowItWorks from '@/components/shop/HowItWorks.astro';
import ReviewsPromo from '@/components/shop/ReviewsPromo.astro';
import Faq from '@/components/shop/Faq.astro';
import CtaBand from '@/components/shop/CtaBand.astro';
import { brand } from '@/config/brand';
import { faq, ideeen } from '@/config/content';
import { producten, sectoren } from '@/lib/catalog';
import { breadcrumbSchema, faqSchema, productenSchema } from '@/lib/schema';
import { url } from '@/lib/url';

const lijst = await producten();
const branches = await sectoren();
---
<BaseLayout
  title="Live volgerstellers voor je zaak | View Plus Shop"
  description="Maak je volgers zichtbaar in je zaak: live tellers met klapcijfers voor Instagram, Facebook, TikTok, YouTube, LinkedIn en X, of voor je eigen getal. Met 5 of 7 cijfers."
  path="/"
  page="home"
  schemas={[breadcrumbSchema([{ name: 'Shop', path: '/' }]), productenSchema(lijst), faqSchema(faq)]}
>
  <section class="grid-bg relative overflow-hidden">
    <div class="container-rp grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.1fr_1fr]">
      <div class="grid gap-6">
        <p class="chip w-fit">Live volgerstellers · 6 platformen · NL &amp; BE</p>
        <h1 class="text-4xl md:text-[3.4rem]">Maak je volgers zichtbaar in je zaak</h1>
        <p class="max-w-xl text-lg leading-relaxed text-ink-soft">
          Met een live volgersteller zien je gasten hoeveel volgers je hebt op Instagram, Facebook, TikTok, YouTube, LinkedIn
          of X. De klapcijfers draaien mee bij elke nieuwe volger. Kies je platform en 5 of 7 cijfers.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#producten" class="btn btn-primary btn-lg">Bekijk de producten</a>
          <a href={url('/contact')} class="btn btn-secondary btn-lg" data-track="advies_klik" data-track-plek="hero">Vraag advies</a>
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft">
          <li class="flex items-center gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> 6 platformen of je eigen getal</li>
          <li class="flex items-center gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> Klapcijfers die meedraaien</li>
          <li class="flex items-center gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> 5 of 7 cijfers</li>
        </ul>
      </div>
      <TellerKiezer id="demo-teller" />
    </div>
  </section>

  <HowItWorks />

  <section id="producten" class="container-rp scroll-mt-32 py-12" aria-labelledby="producten-title">
    <p class="eyebrow">Het aanbod</p>
    <h2 id="producten-title" class="mt-2 text-3xl md:text-4xl">Kies wat bij jouw zaak past</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {lijst.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <ReviewsPromo />

  <section class="container-rp py-12" aria-labelledby="online-title">
    <div class="card grid gap-6 p-8 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="eyebrow">View Plus Online</p>
        <h2 id="online-title" class="mt-2 text-2xl">Nieuwe volgers verdienen sterke content</h2>
        <p class="mt-2 max-w-2xl text-ink-soft">Met View Plus Online nemen we je social media volledig uit handen: professionele fotografie, een contentkalender en 2 tot 3 posts per week.</p>
      </div>
      <a href={`${brand.hoofdsiteUrl}/plans`} class="btn btn-secondary">Bekijk View Plus Online</a>
    </div>
  </section>

  <section class="container-rp py-12" aria-labelledby="ideeen-title">
    <p class="eyebrow">Ideeën</p>
    <h2 id="ideeen-title" class="mt-2 text-3xl md:text-4xl">Zo zet je de teller in</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">Van café tot kantoor: elke zaak heeft een eigen reden om te volgen. Een paar ideeën om mee te beginnen.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {ideeen.map((idee) => {
        const sector = idee.sector ? branches.find((s) => s.data.slug === idee.sector) : undefined;
        const doel = sector ? `/voor/${sector.data.slug}` : `/${idee.product}`;
        const linktekst = sector ? `Meer voor ${sector.data.naam.toLowerCase()}` : idee.product === 'live-teller-op-maat' ? 'Bekijk de teller naar keuze' : 'Bekijk de volgersteller';
        return (
          <li class="card grid content-start gap-2 p-5">
            <h3 class="title">{idee.titel}</h3>
            <p class="text-[.95rem] leading-relaxed text-ink-soft">{idee.tekst}</p>
            <a href={url(doel)} class="mt-1 w-fit text-sm font-medium text-brand-600 hover:underline">
              {linktekst} <span aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ul>
    <div class="mt-8 flex flex-wrap items-center gap-2">
      <span class="text-sm text-muted">Per branche:</span>
      {branches.map((s) => <a class="btn btn-secondary !min-h-[40px] !px-4 text-sm" href={url(`/voor/${s.data.slug}`)}>{s.data.naam}</a>)}
    </div>
  </section>

  <Faq items={faq} />
  <CtaBand />
</BaseLayout>
