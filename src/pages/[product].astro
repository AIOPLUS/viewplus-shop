---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Teller from '@/components/shop/Teller.astro';
import Faq from '@/components/shop/Faq.astro';
import CtaBand from '@/components/shop/CtaBand.astro';
import { PRICE_NOTE, VERZENDING } from '@/config/site';
import { platformPaginas } from '@/config/platformpaginas';
import { producten, type Product } from '@/lib/catalog';
import { platformStijl } from '@/lib/platformen';
import { brandIcon, platformIconen } from '@/lib/icons';
import { breadcrumbSchema, faqSchema, productSchema } from '@/lib/schema';
import { euro, inclBtwTekst } from '@/lib/prijs';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const lijst = await producten();
  return lijst.map((p) => ({ params: { product: p.data.slug }, props: { product: p } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const p = product.data;
const { Content } = await render(product);
const eersteVariant = p.varianten[0]!;
const opMaat = p.visual === 'teller-op-maat';
const iconen = await platformIconen();
const gegevens = {
  iconen,
  maatwerk: p.platformen.filter((pl) => platformStijl[pl].koppeling === 'maatwerk'),
  eenheden: Object.fromEntries(p.platformen.map((pl) => [pl, platformStijl[pl].eenheid])),
};
const chip = opMaat ? 'Live via Zapier of API' : 'Live bijgewerkt via wifi';
const stappen = [
  ['Stroom erop en verbinden', 'met wifi (2,4 GHz) of een netwerkkabel.'],
  ['Account koppelen', opMaat ? 'zonder code via Zapier, of met een eigen koppeling.' : 'via je telefoon of computer; voor YouTube, LinkedIn en X stemmen we de koppeling met je af.'],
  ['Het getal draait mee', opMaat ? 'bij elke nieuwe bestelling, gast of verkoop die je koppelt.' : 'bij elke nieuwe volger of abonnee.'],
];
---
<BaseLayout
  title={`${p.naam} | View Plus Shop`}
  description={p.samenvatting.slice(0, 155).replace(/\s+\S*$/, '') + '…'}
  path={`/${p.slug}`}
  ogImage={`/og/${p.slug}.png`}
  page="product"
  schemas={[productSchema(product), breadcrumbSchema([{ name: 'Shop', path: '/' }, { name: p.naam, path: `/${p.slug}` }]), faqSchema(p.faq)]}
>
  <nav aria-label="Kruimelpad" class="container-rp pt-6 text-sm text-muted">
    <ol class="flex gap-2">
      <li><a href={url('/')} class="hover:text-brand-600">Shop</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink">{p.naam}</li>
    </ol>
  </nav>

  <section class="container-rp grid gap-10 py-8 lg:grid-cols-2 lg:py-12" data-product-view={p.slug}>
    <div class="grid content-start gap-3">
      <div class="card relative aspect-[4/3] overflow-hidden !rounded-[var(--radius-panel)]">
        <div class="rp-stage grid h-full w-full place-items-center p-[8%]">
          <Teller id="product-teller" platform={opMaat ? 'op-maat' : p.platformen[0]} waarde={opMaat ? 486 : 1248} class="w-full" />
        </div>
      </div>
      <p class="flex flex-wrap justify-between gap-x-4 gap-y-1 text-xs text-muted">
        <span>Illustratie. Productfoto’s volgen.</span>
        <span data-formaat>Ware grootte: 42 × 10,5 cm</span>
      </p>

      <!-- Probeer het zelf: eigen getal (en bij de teller naar keuze een eigen logo). Blijft in de browser. -->
      <div class="soft-card mt-2 grid gap-3 p-5" data-probeer>
        <p class="text-lg font-medium text-ink">Probeer het met {opMaat ? 'jouw getal en logo' : 'jouw aantal volgers'}</p>
        <form class="flex flex-wrap gap-2" data-probeer-getal novalidate>
          <label for="probeer-getal" class="sr-only">{opMaat ? 'Jouw getal' : 'Jouw aantal volgers'}</label>
          <input id="probeer-getal" type="number" inputmode="numeric" min="0" step="1" placeholder={opMaat ? 'Bijv. 312' : 'Bijv. 2350'} class="input !min-h-[44px] min-w-0 flex-1 !rounded-full" />
          <button type="submit" class="btn btn-secondary !min-h-[44px]">Laat zien</button>
        </form>
        {opMaat && (
          <div class="flex flex-wrap items-center gap-2">
            <label class="btn btn-secondary !min-h-[44px] cursor-pointer has-focus-visible:ring-4 has-focus-visible:ring-brand-200">
              <input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" class="sr-only" data-probeer-logo />
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16" /></svg>
              Kies je logo
            </label>
            <button type="button" class="btn btn-ghost !min-h-[44px]" data-probeer-logo-weg hidden>Logo weghalen</button>
          </div>
        )}
        <p class="hint" aria-live="polite" data-probeer-melding>Alleen een voorbeeld op je eigen scherm: we slaan niets op en sturen niets door.</p>
        {opMaat && (
          <p class="hint">
            Tips voor je logo: het drukvlak is 7 × 7 cm, dus kies een logo zonder kleine tekst. Wit wordt niet gedrukt (daar
            zie je het hout) en pastelkleuren worden grauw. De klapcijfers zijn altijd zwart.
          </p>
        )}
      </div>
    </div>

    <div class="grid content-start gap-6">
      <p class="chip w-fit">{chip}</p>
      <h1 class="text-4xl md:text-5xl">{p.naam}</h1>
      <p class="text-lg leading-relaxed text-ink-soft">{p.samenvatting}</p>

      <form class="grid gap-6" data-product-form data-slug={p.slug} data-varianten={JSON.stringify(p.varianten)} data-gegevens={JSON.stringify(gegevens)} novalidate>
        {p.platformen.length > 0 && (
          <fieldset class="field">
            <legend class="mb-2">Platform</legend>
            <div class="flex flex-wrap gap-2">
              {p.platformen.map((pl, i) => {
                const svg = brandIcon(platformStijl[pl].icoon);
                return (
                  <label class="flex cursor-pointer items-center gap-2 rounded-full border border-brand-200 bg-white px-4 py-2.5 text-[.95rem] text-ink transition-colors hover:bg-brand-50 has-checked:border-brand-600 has-checked:bg-brand-100 has-checked:text-brand-700 has-focus-visible:ring-4 has-focus-visible:ring-brand-100">
                    <input type="radio" name="platform" value={pl} class="sr-only" checked={i === 0} />
                    <svg width="16" height="16" viewBox={svg.viewBox} fill="currentColor" aria-hidden="true" set:html={svg.body} />{pl}
                  </label>
                );
              })}
            </div>
            <p class="hint" data-maatwerk-hint hidden>Voor dit platform stemmen we de koppeling met je af; die werkt net iets anders dan bij Instagram, Facebook en TikTok.</p>
          </fieldset>
        )}

        {p.varianten.length > 1 && (
          <fieldset class="field">
            <legend class="mb-2">Uitvoering</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              {p.varianten.map((v, i) => (
                <label class="grid cursor-pointer gap-1 rounded-2xl border border-brand-200 bg-white p-4 transition-colors hover:bg-brand-50 has-checked:border-brand-600 has-checked:bg-brand-50 has-focus-visible:ring-4 has-focus-visible:ring-brand-100">
                  <input type="radio" name="variant" value={v.id} class="sr-only" checked={i === 0} />
                  <span class="text-lg font-medium text-ink">{v.label}</span>
                  {v.omschrijving && <span class="text-sm text-ink-soft">{v.omschrijving}</span>}
                  <span class="text-sm text-muted">{v.prijs === null ? 'Prijs volgt' : `€ ${euro(v.prijs)} ${PRICE_NOTE}`}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )}
        {p.varianten.length === 1 && <input type="hidden" name="variant" value={eersteVariant.id} />}

        <div class="grid gap-1" aria-live="polite">
          <p class="flex flex-wrap items-baseline gap-x-2 text-2xl">
            <span class="font-semibold" data-prijs>{eersteVariant.prijs === null ? 'Prijs volgt' : `€ ${euro(eersteVariant.prijs)}`}</span>
            <span class="text-[.8em] text-muted" data-prijs-toelichting>
              {eersteVariant.prijs === null ? 'vraag gerust een offerte aan' : `${PRICE_NOTE}, € ${inclBtwTekst(eersteVariant.prijs)} incl. 21% btw`}
            </span>
          </p>
          <p class="text-sm text-muted">{VERZENDING.levertijd ? `Levertijd: ${VERZENDING.levertijd}` : 'Levertijd en verzendkosten staan in je orderbevestiging'}</p>
        </div>

        <div class="flex flex-wrap items-center gap-3" data-bestelblok>
          <div class="flex items-center rounded-full border border-line-strong">
            <button type="button" class="size-11 rounded-full text-xl text-brand-600 hover:bg-brand-100" data-stap="-1" aria-label="Eén minder">−</button>
            <label for="aantal" class="sr-only">Aantal</label>
            <input id="aantal" name="aantal" type="number" inputmode="numeric" min="1" max="20" value="1" class="w-14 border-0 bg-transparent text-center text-lg [appearance:textfield] focus:outline-none" />
            <button type="button" class="size-11 rounded-full text-xl text-brand-600 hover:bg-brand-100" data-stap="1" aria-label="Eén meer">+</button>
          </div>
          <button type="submit" class="btn btn-primary btn-lg" data-toevoegen>In winkelwagen</button>
        </div>
        <a href={url(`/contact?product=${p.slug}`)} class="btn btn-primary btn-lg w-fit" data-offerte hidden>Vraag een offerte aan</a>
        <p class="text-sm text-success" role="status" data-toegevoegd hidden>
          Toegevoegd aan je winkelwagen. <a href={url('/winkelwagen')} class="font-medium underline">Bekijk je winkelwagen</a>
        </p>
      </form>

      <ul class="grid gap-2">
        {p.voordelen.map((v) => (
          <li class="flex gap-3 text-ink-soft"><span class="mt-0.5 text-brand-600" aria-hidden="true">✓</span>{v}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-rp grid gap-8 py-12 lg:grid-cols-2" aria-labelledby="zo-werkt-het">
    <div>
      <h2 id="zo-werkt-het" class="text-3xl">Zo werkt het</h2>
      <ol class="mt-6 grid gap-4">
        {stappen.map(([kop, tekst], i) => (
          <li class="flex gap-4"><span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-100 font-semibold text-brand-600">{i + 1}</span><p class="text-ink-soft"><strong class="text-ink">{kop}</strong> {tekst}</p></li>
        ))}
      </ol>
      <div class="prose-rp mt-6"><Content /></div>
      {p.inDeDoos.length > 0 && (
        <div class="mt-6">
          <h3 class="text-lg !text-ink">In de doos</h3>
          <ul class="mt-2 grid gap-1 text-ink-soft">{p.inDeDoos.map((x) => <li class="flex gap-3"><span class="text-brand-600" aria-hidden="true">✓</span>{x}</li>)}</ul>
        </div>
      )}
    </div>
    {p.specs.length > 0 && (
      <div class="card h-fit p-6">
        <h2 class="text-xl">Specificaties</h2>
        <dl class="mt-4 divide-y divide-line">
          {p.specs.map((s) => (
            <div class="grid grid-cols-[140px_1fr] gap-4 py-3 text-sm">
              <dt class="text-muted">{s.label}</dt>
              <dd class="text-ink">{s.waarde}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </section>

  {p.platformen.length > 0 && (
    <section class="container-rp py-4" aria-labelledby="per-platform-title">
      <h2 id="per-platform-title" class="text-xl">Meer per platform</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {p.platformen.map((pl) => {
          const svg = brandIcon(platformStijl[pl].icoon);
          return (
            <li>
              <a href={url(`/volgersteller/${platformPaginas[pl].slug}`)} class="btn btn-secondary !min-h-[44px]">
                <svg width="16" height="16" viewBox={svg.viewBox} fill="currentColor" aria-hidden="true" set:html={svg.body} />{platformPaginas[pl].naam}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <Faq items={p.faq} />
  <CtaBand />
</BaseLayout>

<script>
  import { toevoegen, MAX_PER_REGEL } from '@/lib/client/winkelwagen';
  import { setTeller, zetCijfers, zetLogo, zetPlatform, type PlatformIcoon } from '@/lib/client/teller';
  import { track } from '@/lib/client/analytics';

  interface Variant { id: string; label: string; prijs: number | null }
  interface Gegevens { iconen: Record<string, PlatformIcoon>; maatwerk: string[]; eenheden: Record<string, string> }

  const form = document.querySelector<HTMLFormElement>('[data-product-form]');
  const kast = document.querySelector<HTMLElement>('#product-teller');
  if (form && kast) {
    const varianten = JSON.parse(form.dataset.varianten ?? '[]') as Variant[];
    const g = JSON.parse(form.dataset.gegevens ?? '{}') as Gegevens;
    const keuze = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? form.querySelector<HTMLInputElement>(`input[name="${name}"]`)?.value ?? '';
    const euro = (n: number) => n.toLocaleString('nl-NL', { minimumFractionDigits: Number.isInteger(n) ? 0 : 2, maximumFractionDigits: 2 });
    const bestelblok = form.querySelector<HTMLElement>('[data-bestelblok]')!;
    const offerte = form.querySelector<HTMLElement>('[data-offerte]')!;
    const toegevoegd = form.querySelector<HTMLElement>('[data-toegevoegd]')!;
    const hint = form.querySelector<HTMLElement>('[data-maatwerk-hint]');
    const aantalVeld = form.elements.namedItem('aantal') as HTMLInputElement;
    const formaat = document.querySelector<HTMLElement>('[data-formaat]')!;
    const probeerMelding = document.querySelector<HTMLElement>('[data-probeer-melding]');
    const probeerStandaard = probeerMelding?.textContent ?? '';

    // Keuze vanuit de kiezer op de homepage: ?platform=YouTube&cijfers=7
    const qs = new URLSearchParams(location.search);
    const kies = (name: string, value: string | null) => {
      const el = value ? form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(value)}"]`) : null;
      if (el) el.checked = true;
    };
    kies('platform', qs.get('platform'));
    kies('variant', qs.get('cijfers') ? `${qs.get('cijfers')}-cijfers` : null);

    const update = () => {
      const variant = varianten.find((v) => v.id === keuze('variant')) ?? varianten[0]!;
      const prijs = variant.prijs;
      form.querySelector('[data-prijs]')!.textContent = prijs === null ? 'Prijs volgt' : `€ ${euro(prijs)}`;
      form.querySelector('[data-prijs-toelichting]')!.textContent =
        prijs === null ? 'vraag gerust een offerte aan' : `excl. btw, € ${euro(Math.round(prijs * 121) / 100)} incl. 21% btw`;
      bestelblok.hidden = prijs === null;
      offerte.hidden = prijs !== null;
      // Illustratie meewisselen: platform en aantal cijfers
      const platform = keuze('platform');
      if (platform) zetPlatform(kast, platform, g.iconen);
      const cijfers = variant.id.startsWith('7') ? 7 : 5;
      zetCijfers(kast, cijfers);
      formaat.textContent = `Ware grootte: ${cijfers === 7 ? '56,4' : '42'} × 10,5 cm`;
      if (probeerMelding && cijfers === 7 && probeerMelding.textContent?.includes('Kies 7 cijfers')) probeerMelding.textContent = probeerStandaard;
      if (hint) hint.hidden = !g.maatwerk.includes(platform);
      toegevoegd.hidden = true;
    };
    form.querySelectorAll('input[type=radio]').forEach((el) => el.addEventListener('change', update));
    update();

    form.querySelectorAll<HTMLButtonElement>('[data-stap]').forEach((b) =>
      b.addEventListener('click', () => {
        aantalVeld.value = String(Math.max(1, Math.min(MAX_PER_REGEL, (Number(aantalVeld.value) || 1) + Number(b.dataset.stap))));
      }),
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const variant = varianten.find((v) => v.id === keuze('variant'));
      if (!variant || variant.prijs === null) return;
      const aantal = Math.max(1, Math.min(MAX_PER_REGEL, Math.round(Number(aantalVeld.value) || 1)));
      aantalVeld.value = String(aantal);
      toevoegen({ slug: form.dataset.slug!, variant: variant.id, platform: keuze('platform') || null, aantal });
      track('product_toegevoegd', { product: form.dataset.slug!, variant: variant.id });
      toegevoegd.hidden = false;
    });

    // Probeer het zelf: eigen getal en (teller naar keuze) eigen logo. Alles blijft in de browser.
    const probeer = document.querySelector<HTMLElement>('[data-probeer]');
    if (probeer) {
      const melding = probeerMelding!;
      const standaardMelding = probeerStandaard;
      const getalVeld = probeer.querySelector<HTMLInputElement>('#probeer-getal')!;
      probeer.querySelector('[data-probeer-getal]')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const n = Math.round(Number(getalVeld.value));
        if (!getalVeld.value || !Number.isFinite(n) || n < 0) {
          melding.textContent = 'Vul een getal in, bijvoorbeeld 2350.';
          return;
        }
        const cijfers = Number(kast.dataset.cijfers) === 7 ? 7 : 5;
        const max = 10 ** cijfers - 1;
        melding.textContent =
          n > 9_999_999 ? 'Zo groot telt geen enkele teller: 7 cijfers gaat tot 9.999.999.'
          : n > max ? 'Met 5 cijfers tel je tot 99.999. Kies 7 cijfers om dit getal te tonen.'
          : standaardMelding;
        void setTeller(kast, Math.min(n, 9_999_999));
        track('probeer_getal', { product: form.dataset.slug! });
      });

      let logoUrl: string | null = null;
      const logoVeld = probeer.querySelector<HTMLInputElement>('[data-probeer-logo]');
      const logoWeg = probeer.querySelector<HTMLButtonElement>('[data-probeer-logo-weg]');
      const zetEigenLogo = (url: string | null) => {
        if (logoUrl) URL.revokeObjectURL(logoUrl);
        logoUrl = url;
        zetLogo(kast, url);
        if (logoWeg) logoWeg.hidden = !url;
      };
      logoVeld?.addEventListener('change', () => {
        const bestand = logoVeld.files?.[0];
        if (!bestand) return;
        if (!bestand.type.startsWith('image/') || bestand.size > 5 * 1024 * 1024) {
          melding.textContent = 'Kies een afbeelding (PNG, JPG, SVG of WebP) van maximaal 5 MB.';
          return;
        }
        zetEigenLogo(URL.createObjectURL(bestand));
        melding.textContent = standaardMelding;
        track('probeer_logo', { product: form.dataset.slug! });
      });
      logoWeg?.addEventListener('click', () => {
        zetEigenLogo(null);
        if (logoVeld) logoVeld.value = '';
      });
    }
  }
</script>
