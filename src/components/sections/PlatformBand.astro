---
import { Image } from 'astro:assets';
import bg from '@/assets/img/hero-kaart-bg.png';
import { platformen } from '@/config/content';
import { brandIcon } from '@/lib/icons';

const woorden = ['LIVE', 'VOLGERS', 'TELLERS', 'NFC'];
const items = platformen.map((p) => ({ ...p, svg: p.icoon ? brandIcon(p.icoon) : null }));
---
<div class="relative isolate overflow-hidden rounded-[24px] bg-brand-600 text-white">
  <Image src={bg} alt="" class="absolute inset-0 -z-10 size-full object-cover" widths={[800, 1400, 2000]} sizes="(min-width: 1360px) 1296px, 100vw" loading="eager" fetchpriority="high" />

  <!-- Lopende tekst -->
  <div class="overflow-hidden pt-8 lg:pt-10" aria-hidden="true">
    <div class="marquee">
      {[...woorden, ...woorden].map((w) => (
        <span class="flex items-center gap-8 pr-8 text-[64px] font-semibold leading-none tracking-[-0.02em] lg:text-[128px]">
          <span class="bg-gradient-to-b from-white to-white/55 bg-clip-text text-transparent">{w}</span>
          <span class="size-3 rounded-full bg-white/80 lg:size-4"></span>
        </span>
      ))}
    </div>
  </div>
  <p class="sr-only">Live volgerstellers en NFC</p>

  <div class="mx-8 mt-8 h-px bg-white/20 lg:mx-16 lg:mt-12" aria-hidden="true"></div>

  <div class="grid justify-items-center gap-10 pb-12 pt-12 text-center lg:pb-16">
    <h2 class="max-w-[560px] px-6 text-2xl font-normal leading-snug lg:text-[28px]">Voor de platformen waar jouw klanten zijn.</h2>

    <!-- Logo's: lopen als je er met de muis overheen gaat (op touchscreens lopen ze vanzelf) -->
    <div class="logo-band relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
      <ul class="logo-track flex w-max items-center" aria-label="Platformen">
        {[0, 1].map((kopie) => items.map((p) => (
          <li class="flex shrink-0 items-center gap-3 px-7 lg:px-9" aria-hidden={kopie === 1 ? 'true' : undefined}>
            {p.svg && (
              <svg viewBox={p.svg.viewBox} class:list={[p.woordmerk ? 'h-9 lg:h-10' : 'h-7 lg:h-8', 'w-auto shrink-0', p.icoon?.startsWith('logos:') && 'brightness-0 invert']} fill="currentColor" aria-hidden="true" set:html={p.svg.body} />
            )}
            <span class:list={[p.woordmerk ? 'sr-only' : 'whitespace-nowrap text-xl font-medium tracking-tight lg:text-[22px]']}>{p.naam}</span>
          </li>
        )))}
      </ul>
    </div>
  </div>
</div>

<style>
  .logo-track { animation: logos 60s linear infinite; animation-play-state: paused; }
  .logo-band:hover .logo-track,
  .logo-band:focus-within .logo-track { animation-play-state: running; }
  /* Geen muis (telefoon, tablet): laat de logo's vanzelf lopen */
  @media (hover: none) { .logo-track { animation-play-state: running; } }
  @keyframes logos { to { transform: translateX(-50%); } }
</style>
