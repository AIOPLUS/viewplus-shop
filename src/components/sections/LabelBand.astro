---
/**
 * Band naar het zusterlabel, in de kleur van dát label: zo voelen Review Plus en View Plus als één omgeving.
 * Toont niets als het andere label (nog) geen URL heeft.
 */
import { brand, labels } from '@/config/brand';

const ander = labels.find((l) => l.id !== brand.id && l.url);
const tekst: Record<string, { titel: string; tekst: string }> = {
  reviewplus: {
    titel: 'Ook meer Google-reviews?',
    tekst: 'In de shop van ons zusterlabel Review Plus vraag je NFC-reviewkaarten aan, zodat klanten met één tik een review achterlaten.',
  },
  viewplus: {
    titel: 'Ook sterke content op social media?',
    tekst: 'Goede reviews overtuigen, sterke content trekt mensen aan. View Plus neemt je social media uit handen, met professionele fotografie en actief beheer.',
  },
};
const t = ander ? tekst[ander.id] : undefined;
---
{ander && t && (
  <section class="pt-10" aria-labelledby="label-band-title">
    <div class="container-rp">
      <div class="reveal relative isolate grid items-center gap-8 overflow-hidden rounded-[var(--radius-panel)] p-8 text-white md:grid-cols-[auto_1fr_auto] lg:p-12" style={`background:${ander.kleur}`}>
        <svg class="pointer-events-none absolute -right-10 -top-10 -z-10 w-[260px] opacity-15" viewBox="0 0 906 958" fill="#fff" aria-hidden="true"><path d="M0 0H386V410A386 410 0 0 1 0 0Z" /><rect x="520" width="386" height="410" /><path d="M386 548V958H0A386 410 0 0 1 386 548Z" /><rect x="520" y="548" width="386" height="410" /></svg>
        <p class="flex items-center gap-3 text-2xl leading-none">
          <svg width="30" height="32" viewBox="0 0 906 958" fill="#fff" aria-hidden="true"><path d="M0 0H386V410A386 410 0 0 1 0 0Z" /><rect x="520" width="386" height="410" /><path d="M386 548V958H0A386 410 0 0 1 386 548Z" /><rect x="520" y="548" width="386" height="410" /></svg>
          <span><span class="font-semibold">{ander.naam[0]}</span> {ander.naam[1]}</span>
        </p>
        <div class="grid gap-2">
          <h2 id="label-band-title" class="text-2xl font-medium leading-snug">{t.titel}</h2>
          <p class="max-w-[620px] text-white/90">{t.tekst}</p>
        </div>
        <a href={ander.url} class="btn btn-white w-fit" style={`color:${ander.kleur}`} data-track="label_wissel" data-track-plek="band">Naar {ander.naam.join(' ')}</a>
      </div>
    </div>
  </section>
)}
