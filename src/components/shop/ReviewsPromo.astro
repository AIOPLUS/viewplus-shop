---
/**
 * Promoblok (tegenhanger van het totemblok in de Review Plus-shop): de live teller naar keuze voor je Google-reviews,
 * met een brug naar het zusterlabel Review Plus.
 */
import Teller from './Teller.astro';
import { url } from '@/lib/url';
---
<section class="container-rp py-8" aria-labelledby="reviews-promo">
  <div class="relative grid items-center gap-8 overflow-hidden rounded-[var(--radius-panel)] bg-gradient-to-br from-brand-500 to-brand-600 p-8 text-white shadow-[var(--shadow-glow)] md:grid-cols-[1.2fr_1fr] md:p-12">
    <div class="grid gap-4">
      <p class="chip w-fit !bg-white/15 !text-white">Live teller naar keuze</p>
      <h2 id="reviews-promo" class="text-3xl !text-white md:text-4xl">Laat ook je Google-reviews meetellen</h2>
      <p class="text-white/85">
        De live teller naar keuze toont elk getal dat je koppelt, met je eigen logo ernaast. Bijvoorbeeld je aantal Google-reviews:
        bij elke nieuwe review klapt het getal om. Meer reviews verzamelen? Dat doet ons zusterlabel Review Plus.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href={url('/live-teller-op-maat')} class="btn btn-lg bg-white !text-brand-600 hover:bg-brand-100">Over de teller naar keuze</a>
        <a href="https://www.reviewplus.io" class="btn btn-lg border-white/40 !text-white hover:bg-white/10">Naar Review Plus</a>
      </div>
    </div>
    <div class="mx-auto w-full max-w-[420px]" aria-hidden="true">
      <Teller platform="op-maat" waarde={486} />
    </div>
  </div>
</section>
