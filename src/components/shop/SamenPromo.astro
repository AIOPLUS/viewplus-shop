---
/** "Beter samen": tegenhanger van het totemblok in de Review Plus-shop, met de volgstandaard en de teller. */
import Volgstandaard from './Volgstandaard.astro';
import Teller from './Teller.astro';
import { url } from '@/lib/url';
---
<section class="container-rp py-8" aria-labelledby="samen-promo">
  <div class="relative grid items-center gap-8 overflow-hidden rounded-[var(--radius-panel)] bg-gradient-to-br from-brand-500 to-brand-600 p-8 text-white shadow-[var(--shadow-glow)] md:grid-cols-[1.2fr_1fr] md:p-12">
    <div class="grid gap-4">
      <p class="chip w-fit !bg-white/15 !text-white">Beter samen</p>
      <h2 id="samen-promo" class="text-3xl !text-white md:text-4xl">Tikken, volgen en het getal zien meedraaien</h2>
      <p class="text-white/85">
        De NFC-volgstandaard maakt volgen zo makkelijk als tikken. De live teller laat het resultaat zien: gasten zien het getal
        veranderen op het moment dat ze je volgen.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href={url('/nfc-volgstandaard')} class="btn btn-lg bg-white !text-brand-600 hover:bg-brand-100">Over de volgstandaard</a>
        <a href={url('/live-volgersteller')} class="btn btn-lg border-white/40 !text-white hover:bg-white/10">Over de teller</a>
      </div>
    </div>
    <div class="mx-auto grid w-full max-w-[420px] grid-cols-[0.85fr_1.4fr] items-end gap-5" aria-hidden="true">
      <Volgstandaard platform="Instagram" />
      <Teller platform="Instagram" waarde={1249} class="mb-6" />
    </div>
  </div>
</section>
