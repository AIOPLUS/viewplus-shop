---
/** Afsluitende band in de stijl van de Review Plus-shop, met het merkmotief in de onderhoeken. */
import { url } from '@/lib/url';
import BrandCorners from './BrandCorners.astro';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Twijfel je welke teller past?',
  text = 'Vertel ons over jouw zaak, dan adviseren we welk platform en hoeveel cijfers het best passen.',
} = Astro.props;
---
<section class="container-rp py-16">
  <div class="relative grid justify-items-center gap-5 overflow-hidden rounded-[var(--radius-panel)] border border-brand-200 bg-white px-6 pb-36 pt-14 text-center md:pb-24">
    <p class="text-sm font-medium tracking-wide text-brand-600">Live volgers. <span class="text-ink">Klik. Klak. Volg.</span></p>
    <h2 class="relative max-w-2xl text-3xl md:text-4xl">{title}</h2>
    <p class="relative max-w-xl text-ink-soft">{text}</p>
    <div class="relative flex flex-wrap justify-center gap-3">
      <a href={url('/contact')} class="btn btn-primary btn-lg" data-track="advies_klik" data-track-plek="cta">Vraag advies</a>
      <a href={url('/#producten')} class="btn btn-secondary btn-lg">Bekijk de producten</a>
    </div>
    <BrandCorners />
  </div>
</section>
