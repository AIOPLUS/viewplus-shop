---
/** Kiest de juiste illustratie bij een product (er zijn nog geen productfoto's). */
import Teller from './Teller.astro';
import type { Product, Platform } from '@/lib/catalog';

interface Props {
  product: Product;
  platform?: Platform;
  cijfers?: 5 | 7;
  class?: string;
  /** Id van de teller, voor scripts die het getal of platform aanpassen. */
  id?: string;
}
const { product, platform, cijfers = 5, class: cls = '', id } = Astro.props;
const p = product.data;
const eerste = (platform ?? p.platformen[0] ?? 'Instagram') as Platform;
---
<Teller platform={p.visual === 'teller-op-maat' ? 'op-maat' : eerste} cijfers={cijfers} waarde={p.visual === 'teller-op-maat' ? 486 : 1248} class={cls} id={id} />
