---
/** Productkaart zoals in de Review Plus-shop: illustratie op het podium, chip, naam, korte tekst, prijs en knoppen. */
import ProductVisual from './ProductVisual.astro';
import PriceTag from './PriceTag.astro';
import { url } from '@/lib/url';
import { vanafPrijs, type Product } from '@/lib/catalog';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const p = product.data;
const heeftPrijs = vanafPrijs(product) !== null;
const chip = p.platformen.length ? `${p.platformen.length} platformen` : 'Eigen getal, zoals reviews';
const statusLabel = { beschikbaar: '', binnenkort: 'Binnenkort', 'op-aanvraag': 'Op aanvraag' }[p.status];
---
<article class="card flex flex-col overflow-hidden">
  <a href={url(`/${p.slug}`)} class="relative block aspect-[4/3] overflow-hidden" tabindex="-1" aria-hidden="true">
    <div class="rp-stage grid h-full w-full place-items-center p-[8%]">
      <ProductVisual product={product} class="w-full" />
    </div>
    <span class="chip absolute left-4 top-4 !bg-white shadow-sm">{chip}</span>
  </a>
  <div class="flex flex-1 flex-col gap-4 p-6">
    <div class="grid gap-2">
      <h3 class="text-xl"><a href={url(`/${p.slug}`)} class="hover:underline">{p.naam}</a></h3>
      <p class="text-ink-soft">{p.kort}</p>
    </div>
    <PriceTag product={product} />
    {statusLabel && <p class="chip w-fit !bg-warning-bg !text-warning">{statusLabel}</p>}
    <div class="mt-auto flex flex-wrap gap-2 pt-2">
      {heeftPrijs ? (
        <a href={url(`/${p.slug}`)} class="btn btn-primary">Kies je uitvoering</a>
      ) : (
        <a href={url(`/contact?product=${p.slug}`)} class="btn btn-primary">Vraag een offerte aan</a>
      )}
      <a href={url(`/${p.slug}`)} class="btn btn-ghost">Meer info<span class="sr-only"> over {p.naam}</span></a>
    </div>
  </div>
</article>
