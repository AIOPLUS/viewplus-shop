---
/**
 * Header zoals in de Review Plus-shop: logo en menu verwijzen naar de hoofdsite, "Shop" is de actieve plek.
 * Bovenaan de labelbalk om te wisselen tussen de shops van Review Plus en View Plus.
 */
import { brand, mainNav } from '@/config/brand';
import { url } from '@/lib/url';
import { producten } from '@/lib/catalog';
import Logo from './Logo.astro';
import LabelSwitch from './LabelSwitch.astro';

// Wat nu te koop is (product|variant met prijs): de winkelwagen ruimt de rest op.
const teKoop = (await producten()).flatMap((p) => p.data.varianten.filter((v) => v.prijs !== null).map((v) => `${p.data.slug}|${v.id}`));
const winkelwagenIcoon = 'M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0';
---
<header class="sticky top-0 z-40 bg-white/85 backdrop-blur supports-[backdrop-filter]:bg-white/70" data-header data-te-koop={JSON.stringify(teKoop)}>
  <!-- Labelbalk: wisselen tussen de shops van Review Plus en View Plus -->
  <div class="border-b border-line/70 bg-surface-alt/90">
    <div class="container-rp flex h-11 items-center">
      <LabelSwitch />
    </div>
  </div>

  <div class="container-rp flex h-[72px] items-center justify-between gap-4">
    <a href={`${brand.hoofdsiteUrl}/`} class="flex items-center gap-2 font-medium text-ink" aria-label="View Plus – naar de homepage">
      <Logo size={26} wordmark />
    </a>

    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex items-center gap-1 rounded-full border border-brand-200 bg-white p-1 text-[.9rem] shadow-[var(--shadow-glow-soft)]">
        {mainNav.map((item) => (
          <li><a href={item.href} class="block rounded-full px-4 py-2 text-ink hover:text-brand-600">{item.label}</a></li>
        ))}
        <li>
          <a href={url('/')} aria-current="page" class="flex items-center gap-2 rounded-full bg-brand-100 px-4 py-2 font-medium text-brand-600">
            <span class="size-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>Shop
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Zoals in de Review Plus-shop: Log in + de hoofdknop van de site (daar "Boek een demo") -->
      <div class="hidden items-center gap-2 lg:flex">
        <a href={brand.appLoginUrl} class="btn btn-secondary !min-h-[40px] !py-2">Log in</a>
        <a href={`${brand.hoofdsiteUrl}/contact`} data-track="kennismaking_klik" data-track-plek="header" class="btn btn-primary !min-h-[40px] !py-2">Plan een kennismaking</a>
      </div>
      <!-- Winkelwagen als ronde knop, met het aantal producten -->
      <a href={url('/winkelwagen')} class="relative grid size-11 place-items-center rounded-full border border-brand-200 bg-white text-brand-600 hover:bg-brand-100" data-track="winkelwagen_klik" data-track-plek="header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={winkelwagenIcoon} /></svg>
        <span class="sr-only">Winkelwagen</span>
        <span class="absolute -right-1 -top-1 grid min-w-5 place-items-center rounded-full bg-brand-600 px-1 text-[11px] font-semibold leading-5 text-white" data-winkelwagen-aantal hidden aria-hidden="true">0</span>
        <span class="sr-only" data-winkelwagen-sr></span>
      </a>

      <details class="group relative lg:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full bg-brand-100 text-brand-600 [&::-webkit-details-marker]:hidden" aria-label="Menu openen">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path class="group-open:hidden" d="M3 6h12M3 12h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="hidden group-open:block" d="m4 4 10 10M14 4 4 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </summary>
        <nav aria-label="Mobiel menu" class="absolute right-0 top-14 w-[min(88vw,320px)] rounded-3xl border border-brand-200 bg-white p-3 shadow-[var(--shadow-glow)]">
          <ul class="grid gap-1">
            {mainNav.map((item) => (
              <li><a href={item.href} class="block rounded-2xl px-4 py-3 text-ink hover:bg-brand-100">{item.label}</a></li>
            ))}
            <li><a href={url('/')} aria-current="page" class="block rounded-2xl bg-brand-100 px-4 py-3 font-medium text-brand-600">Shop</a></li>
          </ul>
          <div class="mt-3 grid gap-2">
            <a href={brand.appLoginUrl} class="btn btn-secondary">Log in</a>
            <a href={`${brand.hoofdsiteUrl}/contact`} data-track="kennismaking_klik" data-track-plek="menu" class="btn btn-primary">Plan een kennismaking</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  import { aantalStuks, bijWijziging, opschonen } from '@/lib/client/winkelwagen';

  opschonen(JSON.parse(document.querySelector<HTMLElement>('[data-header]')?.dataset.teKoop ?? '[]') as string[]);

  // Aantal producten in de winkelwagen naast de knop
  const toonAantal = () => {
    const n = aantalStuks();
    const badge = document.querySelector<HTMLElement>('[data-winkelwagen-aantal]');
    const sr = document.querySelector<HTMLElement>('[data-winkelwagen-sr]');
    if (badge) { badge.textContent = String(n); badge.hidden = n === 0; }
    if (sr) sr.textContent = n ? ` (${n} ${n === 1 ? 'product' : 'producten'})` : ' (leeg)';
  };
  toonAantal();
  bijWijziging(toonAantal);
</script>
