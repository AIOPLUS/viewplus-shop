---
import Logo from './Logo.astro';
import LabelSwitch from './LabelSwitch.astro';
import { brand, mainNav } from '@/config/brand';
import { isCurrent, url } from '@/lib/url';
import { producten } from '@/lib/catalog';

const current = Astro.url.pathname;
// Wat nu te koop is (product|variant met prijs): de winkelwagen ruimt de rest op.
const teKoop = (await producten()).flatMap((p) => p.data.varianten.filter((v) => v.prijs !== null).map((v) => `${p.data.slug}|${v.id}`));
---
<header class="fixed inset-x-0 top-0 z-50" data-header data-te-koop={JSON.stringify(teKoop)}>
  <!-- Labelbalk: wisselen tussen Review Plus en View Plus -->
  <div class="border-b border-line/70 bg-surface-alt/90 backdrop-blur-md">
    <div class="container-rp flex h-11 items-center justify-between gap-4">
      <LabelSwitch />
      <a href={url('/contact')} class="hidden text-[13px] text-ink-soft hover:text-brand-600 md:block">Vragen? Neem contact op</a>
    </div>
  </div>

  <div class="container-rp flex h-[72px] items-center justify-between gap-4 lg:h-[92px]">
    <a href={url('/')} class="shrink-0 rounded-full" aria-label={`${brand.shopName} – home`}>
      <span class="flex items-center gap-2"><Logo size={24} wordmark /><span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-medium text-brand-700">Shop</span></span>
    </a>

    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex items-center rounded-full bg-[#fafafa] p-1 transition-shadow duration-300" data-header-pill>
        {mainNav.map((item) => {
          const active = isCurrent(current, item.href);
          return (
            <li>
              <a
                href={url(item.href)}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex items-center gap-2 rounded-full px-5 py-2.5 text-[15px] transition-colors',
                  active ? 'bg-brand-100 text-brand-600' : 'text-ink hover:text-brand-600',
                ]}
              >
                {active && <span class="size-1.5 rounded-full bg-brand-600" aria-hidden="true" />}
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={url('/winkelwagen')} class="btn btn-primary relative !min-h-[44px] !px-5" data-track="winkelwagen_klik" data-track-plek="header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0" /></svg>
        <span class="max-sm:sr-only">Winkelwagen</span>
        <span class="grid min-w-6 place-items-center rounded-full bg-white px-1.5 text-xs font-semibold text-brand-700" data-winkelwagen-aantal hidden>0</span>
        <span class="sr-only" data-winkelwagen-sr></span>
      </a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full bg-brand-100 text-brand-600 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-menu-icon>
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="container-rp lg:hidden" hidden>
    <div class="grid gap-6 rounded-[var(--radius-panel)] bg-white p-6 shadow-[var(--shadow-card)]">
      <ul class="grid gap-1">
        {mainNav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={isCurrent(current, item.href) ? 'page' : undefined}
              class="block rounded-xl px-3 py-3 text-lg text-ink hover:bg-brand-100 aria-[current=page]:bg-brand-100 aria-[current=page]:text-brand-600"
            >{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="grid gap-2">
        <a href={url('/winkelwagen')} class="btn btn-primary">Naar je winkelwagen</a>
        <a href={url('/contact')} class="btn btn-soft">Vraag advies</a>
      </div>
    </div>
  </div>
</header>

<script>
  import { aantalStuks, bijWijziging, opschonen } from '@/lib/client/winkelwagen';

  opschonen(JSON.parse(document.querySelector<HTMLElement>('[data-header]')?.dataset.teKoop ?? '[]') as string[]);

  // Aantal producten in de winkelwagen naast de knop
  const toonAantal = () => {
    const n = aantalStuks();
    const badge = document.querySelector<HTMLElement>('[data-winkelwagen-aantal]');
    const sr = document.querySelector<HTMLElement>('[data-winkelwagen-sr]');
    if (badge) { badge.textContent = String(n); badge.hidden = n === 0; }
    if (sr) sr.textContent = n ? ` (${n} ${n === 1 ? 'product' : 'producten'})` : ' (leeg)';
  };
  toonAantal();
  bijWijziging(toonAantal);

  const header = document.querySelector<HTMLElement>('[data-header]');
  const pill = document.querySelector<HTMLElement>('[data-header-pill]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  // Bij scrollen krijgt de balk een witte achtergrond, net als op reviewplus.io.
  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    header?.classList.toggle('bg-white/85', scrolled);
    header?.classList.toggle('backdrop-blur-md', scrolled);
    pill?.classList.toggle('shadow-[var(--shadow-card)]', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    header?.classList.toggle('bg-white/85', !open || window.scrollY > 24);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.click();
      toggle.focus();
    }
  });
</script>
