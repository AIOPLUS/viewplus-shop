---
/**
 * Labelschakelaar: wissel tussen Review Plus en View Plus alsof het één dashboard is.
 * Elk label heeft zijn eigen kleur. Je blijft op dezelfde pagina als die op beide sites bestaat (gedeeldePaden),
 * anders ga je naar de homepage van het andere label. Dit bestand is gelijk in reviewplus-site en viewplus-site.
 */
import { brand, gedeeldePaden, labels } from '@/config/brand';
import { BASE_PATH } from '@/config/site';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

// Huidig pad zonder BASE_PATH en zonder .html, bv. "/plans"
let pad = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
if (BASE_PATH !== '/' && pad.startsWith(BASE_PATH)) pad = pad.slice(BASE_PATH.length) || '/';
const doel = gedeeldePaden.includes(pad) ? pad : '/';

const zichtbaar = labels.filter((l) => l.id === brand.id || l.url);
---
{zichtbaar.length > 1 && (
  <nav aria-label="Kies een label" class={cls}>
    <ul class="flex items-center gap-1 rounded-full bg-white p-1 ring-1 ring-line">
      {zichtbaar.map((l) => {
        const actief = l.id === brand.id;
        const inhoud = (
          <>
            <svg width="12" height="13" viewBox="0 0 906 958" fill={l.kleur} aria-hidden="true" class="shrink-0">
              <path d="M0 0H386V410A386 410 0 0 1 0 0Z" /><rect x="520" width="386" height="410" /><path d="M386 548V958H0A386 410 0 0 1 386 548Z" /><rect x="520" y="548" width="386" height="410" />
            </svg>
            <span class="whitespace-nowrap"><span class="font-semibold">{l.naam[0]}</span> {l.naam[1]}</span>
            <span class="hidden whitespace-nowrap text-muted md:inline" aria-hidden="true">· {l.wat}</span>
          </>
        );
        return (
          <li>
            {actief ? (
              <span aria-current="true" class="label-pill label-pill--actief" style={`--label:${l.kleur}`}>{inhoud}<span class="sr-only"> (huidig label, {l.wat.toLowerCase()})</span></span>
            ) : (
              <a href={`${l.url}${doel === '/' ? '' : doel}`} class="label-pill" style={`--label:${l.kleur}`} data-track="label_wissel" data-track-plek={l.id}>{inhoud}<span class="sr-only"> ({l.wat.toLowerCase()})</span></a>
            )}
          </li>
        );
      })}
    </ul>
  </nav>
)}

<style>
  .label-pill {
    display: flex; align-items: center; gap: .45rem;
    padding: .3rem .8rem; border-radius: 1000px; font-size: 13px; line-height: 1.4;
    color: var(--color-ink-soft); text-decoration: none; transition: background-color .2s ease, color .2s ease;
  }
  a.label-pill:hover { background: color-mix(in srgb, var(--label) 8%, white); color: var(--color-ink); }
  .label-pill--actief { background: color-mix(in srgb, var(--label) 11%, white); color: var(--label); }
  .label-pill--actief .text-muted { color: color-mix(in srgb, var(--label) 70%, black); }
</style>
